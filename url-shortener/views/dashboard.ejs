<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Shorty</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="nav-brand">
            <i class="fas fa-link"></i> Shorty
        </a>
        <div class="nav-links">
            <span style="color: #FF4B2B; font-weight: 600;">
                <i class="fas fa-user"></i> <%= user.email %>
            </span>
            <a href="/shorten" class="btn btn-sm">
                <i class="fas fa-plus"></i> New URL
            </a>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <div class="main-container">
        <h1 style="margin-bottom: 1rem;">Your Dashboard</h1>
        <p style="color: #666; margin-bottom: 2rem;">Manage your short URLs and track their performance.</p>

        <!-- Quick Stats -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <h3>Total URLs</h3>
                <div class="number"><%= urls.length %></div>
                <p>Short links created</p>
            </div>
            
            <% 
                let totalClicks = 0;
                urls.forEach(url => totalClicks += url.clicks);
            %>
            <div class="stat-card">
                <h3>Total Clicks</h3>
                <div class="number"><%= totalClicks %></div>
                <p>All-time clicks</p>
            </div>
            
            <% 
                const today = new Date().toISOString().split('T')[0];
                let todayClicks = 0;
                // This would need server-side calculation for production
                // For demo, we'll show a placeholder
                todayClicks = Math.floor(totalClicks * 0.1); // Demo value
            %>
            <div class="stat-card">
                <h3>Today's Clicks</h3>
                <div class="number"><%= todayClicks %></div>
                <p>Clicks today</p>
            </div>
        </div>

        <!-- Quick Shorten -->
        <div class="card" style="margin-bottom: 2rem;">
            <h2 style="margin-bottom: 1rem;">
                <i class="fas fa-magic"></i> Quick Shorten
            </h2>
            <form action="/shorten" method="POST" class="shorten-form">
                <input type="url" name="long_url" placeholder="Paste your long URL here..." required>
                <button type="submit" class="btn">
                    <i class="fas fa-shorten"></i> Shorten
                </button>
            </form>
        </div>

        <!-- URL List -->
        <h2 style="margin-bottom: 1.5rem;">
            <i class="fas fa-list"></i> Your Short URLs
        </h2>
        
        <% if (urls.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem;">
                <i class="fas fa-link" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
                <h3 style="color: #666;">No URLs yet</h3>
                <p style="color: #888; margin: 1rem 0;">Create your first short URL to get started!</p>
                <a href="/shorten" class="btn">Create Your First URL</a>
            </div>
        <% } else { %>
            <div class="url-list">
                <% urls.forEach(url => { %>
                    <div class="url-item">
                        <div class="url-info">
                            <a href="<%= baseUrl %>/<%= url.short_code %>" target="_blank" class="url-short">
                                <i class="fas fa-external-link-alt"></i>
                                <%= baseUrl %>/<%= url.short_code %>
                            </a>
                            <div class="url-original">
                                <i class="fas fa-long-arrow-alt-right"></i>
                                <%= url.long_url.substring(0, 60) %>...
                            </div>
                            <div style="margin-top: 0.5rem; font-size: 0.9rem; color: #888;">
                                <i class="far fa-calendar"></i>
                                Created <%= new Date(url.created_at).toLocaleDateString() %>
                            </div>
                        </div>
                        
                        <div class="url-stats">
                            <div class="stat">
                                <div class="stat-value"><%= url.clicks %></div>
                                <div class="stat-label">CLICKS</div>
                            </div>
                        </div>
                        
                        <div class="url-actions">
                            <a href="/analytics/<%= url.id %>" class="btn btn-sm btn-secondary">
                                <i class="fas fa-chart-line"></i> Analytics
                            </a>
                            <form method="POST" action="/delete/<%= url.id %>" style="display: inline;">
                                <button type="submit" class="btn btn-sm" 
                                        onclick="return confirm('Delete this short URL?')"
                                        style="background: linear-gradient(to right, #ff6b6b, #ee5a52);">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <script>
        // Simple click animation
        document.querySelectorAll('.btn').forEach(btn => {
            btn.addEventListener('click', function() {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
            });
        });
    </script>
</body>
</html>