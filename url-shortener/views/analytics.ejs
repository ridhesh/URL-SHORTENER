<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Analytics</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .ai-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin: 20px 0;
        }
        
        .ai-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .ai-icon {
            font-size: 40px;
        }
        
        .insights {
            background: rgba(255,255,255,0.1);
            padding: 20px;
            border-radius: 10px;
            font-size: 16px;
            line-height: 1.6;
            white-space: pre-line;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🤖 AI-Powered Analytics</h1>
        
        <div class="card">
            <h2>Link Information</h2>
            <p><strong>Short URL:</strong> <%= baseUrl %>/<%= url.short_code %></p>
            <p><strong>Clicks:</strong> <span style="color: #FF4B2B; font-size: 24px;"><%= url.clicks %></span></p>
            <p><strong>Created:</strong> <%= new Date(url.created_at).toLocaleDateString() %></p>
        </div>
        
        <div class="ai-container">
            <div class="ai-header">
                <div class="ai-icon">🤖</div>
                <div>
                    <h2 style="margin: 0;">AI Insights</h2>
                    <p style="opacity: 0.8;">Smart analysis of your link performance</p>
                </div>
            </div>
            
            <div class="insights">
                <%= insights %>
            </div>
        </div>
        
        <div style="margin-top: 20px;">
            <a href="/dashboard" class="btn">← Back to Dashboard</a>
            <a href="<%= baseUrl %>/<%= url.short_code %>" target="_blank" class="btn">Test Link</a>
        </div>
    </div>
</body>
</html>