<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics - <%= url.short_code %></title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <a href="/" class="nav-brand">
            <i class="fas fa-link"></i> Shorty
        </a>
        <div class="nav-links">
            <a href="/dashboard">
                <i class="fas fa-arrow-left"></i> Back
            </a>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <div class="main-container">
        <!-- Header -->
        <div style="margin-bottom: 2rem;">
            <h1>Analytics</h1>
            <div style="background: white; padding: 1rem; border-radius: 10px; margin-top: 1rem;">
                <div style="font-size: 1.2rem; color: #666;">
                    <i class="fas fa-link"></i>
                    <strong style="color: #FF4B2B;"><%= baseUrl %>/<%= url.short_code %></strong>
                </div>
                <div style="color: #888; margin-top: 0.5rem; font-size: 0.9rem;">
                    <i class="fas fa-globe"></i>
                    <%= url.long_url.substring(0, 80) %>...
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <h3>Total Clicks</h3>
                <div class="number"><%= url.clicks %></div>
                <p>All-time total</p>
            </div>
            
            <div class="stat-card">
                <h3>Created</h3>
                <div class="number" style="font-size: 1.5rem;">
                    <%= new Date(url.created_at).toLocaleDateString() %>
                </div>
                <p>Link creation date</p>
            </div>
            
            <div class="stat-card">
                <h3>Status</h3>
                <div class="number" style="font-size: 1.5rem; color: #28a745;">
                    <i class="fas fa-check-circle"></i> Active
                </div>
                <p>Link is working</p>
            </div>
        </div>

        <!-- AI Insights -->
        <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h2 style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-robot"></i> AI Insights
            </h2>
            <div style="margin-top: 1rem; padding: 1rem; background: rgba(255,255,255,0.1); border-radius: 10px;">
                <p style="font-size: 1.1rem; line-height: 1.6;">
                    <i class="fas fa-lightbulb"></i> <%= insights %>
                </p>
            </div>
        </div>

        <!-- Click Chart -->
        <div class="card" style="margin-top: 2rem;">
            <h2 style="margin-bottom: 1.5rem;">
                <i class="fas fa-chart-bar"></i> Click Activity
            </h2>
            
            <% if (dailyClicks.length > 0) { %>
                <div style="margin: 2rem 0;">
                    <% 
                        const maxClicks = Math.max(...dailyClicks.map(d => d.count || 0));
                        dailyClicks.slice(0, 7).reverse().forEach(day => {
                            const width = maxClicks > 0 ? ((day.count || 0) / maxClicks * 100) : 0;
                    %>
                        <div style="margin-bottom: 1rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span><%= new Date(day.date).toLocaleDateString('en-US', { weekday: 'short' }) %></span>
                                <span style="font-weight: 600;"><%= day.count || 0 %> clicks</span>
                            </div>
                            <div class="chart-bar" style="width: <%= width %>%;"></div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 2rem; color: #666;">
                    <i class="fas fa-chart-line" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p style="margin-top: 1rem;">No click data yet</p>
                </div>
            <% } %>
        </div>

        <!-- Hourly Distribution -->
        <% if (hourlyClicks && hourlyClicks.length > 0) { %>
        <div class="card" style="margin-top: 2rem;">
            <h2 style="margin-bottom: 1.5rem;">
                <i class="fas fa-clock"></i> Best Time to Share
            </h2>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
                <% hourlyClicks.forEach(hour => { 
                    const hour12 = hour.hour % 12 || 12;
                    const ampm = hour.hour < 12 ? 'AM' : 'PM';
                %>
                    <div style="background: linear-gradient(to right, #FF4B2B, #FF416C); 
                                color: white; padding: 0.5rem 1rem; border-radius: 20px;
                                font-size: 0.9rem;">
                        <%= hour12 %> <%= ampm %>: <%= hour.count %> clicks
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>

        <!-- Actions -->
        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <a href="<%= baseUrl %>/<%= url.short_code %>" target="_blank" class="btn">
                <i class="fas fa-external-link-alt"></i> Test Your Link
            </a>
            <a href="/dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <script>
        // Animate chart bars
        document.addEventListener('DOMContentLoaded', function() {
            const bars = document.querySelectorAll('.chart-bar');
            bars.forEach((bar, index) => {
                bar.style.width = '0%';
                setTimeout(() => {
                    bar.style.width = bar.style.width;
                }, index * 100);
            });
        });
    </script>
</body>
</html>