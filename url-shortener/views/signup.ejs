<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Shorty</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .auth-container {
            max-width: 400px;
            margin: 4rem auto;
            padding: 0 1rem;
        }
        
        .auth-card {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .auth-header h1 {
            background: linear-gradient(to right, #FF4B2B, #FF416C);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }
        
        .auth-logo {
            font-size: 3rem;
            color: #FF4B2B;
            margin-bottom: 1rem;
        }
        
        .password-hint {
            font-size: 0.8rem;
            color: #666;
            margin-top: 0.25rem;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="nav-brand">
            <i class="fas fa-link"></i> Shorty
        </a>
        <div class="nav-links">
            <a href="/login">Login</a>
            <a href="/">Home</a>
        </div>
    </nav>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-logo">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1>Join Shorty</h1>
                <p style="color: #666;">Create your free account</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-error" style="margin-bottom: 1.5rem;">
                    <i class="fas fa-exclamation-triangle"></i> <%= error %>
                </div>
            <% } %>

            <form method="POST">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="At least 6 characters" required minlength="6">
                    <div class="password-hint">
                        <i class="fas fa-info-circle"></i> Minimum 6 characters
                    </div>
                </div>

                <button type="submit" class="btn" style="width: 100%; margin-top: 1rem;">
                    <i class="fas fa-rocket"></i> Create Account
                </button>
            </form>

            <div style="text-align: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #eee;">
                <p style="color: #666;">Already have an account?</p>
                <a href="/login" class="btn btn-secondary" style="margin-top: 0.5rem;">
                    <i class="fas fa-sign-in-alt"></i> Login Instead
                </a>
            </div>
        </div>
    </div>

    <script>
        // Password strength indicator
        const passwordInput = document.getElementById('password');
        if (passwordInput) {
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                const hint = document.querySelector('.password-hint');
                
                if (password.length === 0) {
                    hint.innerHTML = '<i class="fas fa-info-circle"></i> Minimum 6 characters';
                    hint.style.color = '#666';
                } else if (password.length < 6) {
                    hint.innerHTML = '<i class="fas fa-exclamation-circle"></i> Too short';
                    hint.style.color = '#dc3545';
                } else if (password.length < 8) {
                    hint.innerHTML = '<i class="fas fa-check-circle"></i> Good';
                    hint.style.color = '#28a745';
                } else {
                    hint.innerHTML = '<i class="fas fa-check-circle"></i> Strong password';
                    hint.style.color = '#28a745';
                }
            });
        }
    </script>
</body>
</html>